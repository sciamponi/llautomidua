generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SAAS
  SERVICE
  SOLUTION
  MEDIA
}

enum LeadType {
  GENERAL
  DEMO
  QUOTE
  SCREEN_INSTALLATION
  SCREEN_ADVERTISING
  PARTNER
  SPECIALIST_CLICK
}

enum DemoAccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum RevenueType {
  SUBSCRIPTION
  ONE_TIME
  RECURRING_SERVICE
  MEDIA
}

enum AuthScope {
  GLOBAL
  PRODUCT
  COMPANY
  PARTNER
}

enum UserRole {
  MASTER_ADMIN
  ADMIN
  OPERATOR
  CUSTOMER
  PARTNER
}

enum SiteOrderStatus {
  SUBMITTED
  DATA_REVIEW
  IN_PRODUCTION
  WAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  CANCELLED
}

enum SiteOrderVersionStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  EXPIRED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SIMULATED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
}

enum PaymentStatus {
  PENDING
  PROOF_SUBMITTED
  UNDER_REVIEW
  PAID
  REJECTED
  CANCELLED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  status        String    @default("active")
  
  // Relations
  roles         UserRoleMapping[]
  sessions      Session[]
  auditLogs     AuditLog[]
  partnerProfile PartnerProfile?
  subscriptions Subscription[]
  leads         Lead[]
  siteOrders    SiteOrder[]
  internalNotes InternalNote[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Company {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  document    String?   @unique // CNPJ
  status      String    @default("active")
  
  // Relations
  roles       UserRoleMapping[]
  sessions    Session[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UserRoleMapping {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole
  scope       AuthScope
  
  // Specific context
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  
  createdAt   DateTime  @default(now())

  @@unique([userId, role, scope, companyId, productId])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  
  // Context of the session
  activeCompanyId String?
  activeCompany   Company?  @relation(fields: [activeCompanyId], references: [id])
  activeProductId String?
  activeProduct   Product?  @relation(fields: [activeProductId], references: [id])
  
  ipAddress       String?
  userAgent       String?
  lastUsedAt      DateTime  @updatedAt
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String
  actor       User      @relation(fields: [actorId], references: [id])
  action      String    // LOGIN, LOGOUT, CREATE_USER, CHANGE_ROLE, etc.
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())
}

model PartnerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  commission    Float     @default(0.2)
  clientsCount  Int       @default(0)
  points        Int       @default(0)
  status        String    @default("active")
}

model Product {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  type              ProductType
  category          String
  segment           String
  subcategory       String?
  shortDescription  String
  description       String
  audience          String?
  problem           String?
  solution          String?
  howItWorks        String?
  benefits          Json?     // Array of string or objects
  features          Json?     // Array of {title, desc}
  pricingType       RevenueType
  pricing           String?
  ctaType           String?
  demoUrl           String?
  demoActive        Boolean   @default(true)
  demoDurationHours Int       @default(24)
  landingUrl        String?
  whatsappMessage   String?
  status            String    @default("active")
  featured          Boolean   @default(false)
  sortOrder         Int       @default(0)
  coverImage        String?
  
  // Relations
  gallery           ProductImage[]
  demoAccesses      DemoAccess[]
  leads             Lead[]
  subscriptions     Subscription[]
  recommendations   ProductRecommendation[] @relation("MainProduct")
  recommendedBy     ProductRecommendation[] @relation("RecommendedProduct")
  roleMappings      UserRoleMapping[]
  sessions          Session[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model DemoAccess {
  id            String           @id @default(cuid())
  leadId        String
  lead          Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  tokenHash     String           @unique
  status        DemoAccessStatus @default(ACTIVE)
  expiresAt     DateTime
  firstAccessAt DateTime?
  lastAccessAt  DateTime?
  accessCount   Int              @default(0)
  revokedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductRecommendation {
  id                  String    @id @default(cuid())
  productId           String
  product             Product   @relation("MainProduct", fields: [productId], references: [id])
  recommendedProductId String
  recommendedProduct  Product   @relation("RecommendedProduct", fields: [recommendedProductId], references: [id])
  reason              String
  priority            Int       @default(0)
  status              String    @default("active")
}

model Lead {
  id            String    @id @default(cuid())
  name          String
  email         String?
  whatsapp      String
  company       String?
  city          String?
  address       String?
  establishmentType String?
  screenCount   Int?
  segment       String?
  objective     String?
  message       String?
  type          LeadType  @default(GENERAL)
  status        String    @default("new")
  source        String?   // e.g., "DEMO", "LANDING", "MEGA_MENU"
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  productId     String?
  product       Product?  @relation(fields: [productId], references: [id])
  demoAccesses  DemoAccess[]
  createdAt     DateTime  @default(now())
  diagnosticSessionId String? @unique
  diagnosticSession   DiagnosticSession? @relation(fields: [diagnosticSessionId], references: [id])
}

model DiagnosticSession {
  id                String    @id @default(cuid())
  leadId            String?
  sessionId         String?
  currentStep       Int       @default(1)
  status            String    @default("started") // started, in_progress, completed, abandoned
  businessSegment   String?
  mainProblem       String?
  specificNeed      String?
  currentOperation  String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lead              Lead?     
  result            DiagnosticResult?
}

model DiagnosticResult {
  id                  String    @id @default(cuid())
  diagnosticSessionId String    @unique
  diagnosticSession   DiagnosticSession @relation(fields: [diagnosticSessionId], references: [id])
  recommendedProductId String?
  confidence          String?   // HIGH, MEDIUM, LOW
  score               Int       @default(0)
  reason              String?
  recommendations     DiagnosticRecommendation[]
  createdAt           DateTime  @default(now())
}

model DiagnosticRecommendation {
  id                  String    @id @default(cuid())
  diagnosticResultId  String
  diagnosticResult    DiagnosticResult @relation(fields: [diagnosticResultId], references: [id])
  productId           String
  score               Int
  position            Int       @default(0)
  reason              String?
}

model DiagnosticRule {
  id          String    @id @default(cuid())
  segment     String?
  problem     String?
  need        String?
  operation   String?
  productId   String
  score       Int
  priority    Int       @default(0)
  message     String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Course {
  id            String    @id @default(cuid())
  title         String
  description   String
  thumbnail     String?
  lessons       Lesson[]
  createdAt     DateTime  @default(now())
}

model Lesson {
  id            String    @id @default(cuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  title         String
  videoUrl      String
  duration      String?
  order         Int
  createdAt     DateTime  @default(now())
}

model SiteTemplate {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  category      String
  segment       String
  description   String
  application   String?
  previewImage  String?
  externalUrl   String?
  status        String    @default("active")
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  orders        SiteOrder[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SiteOrder {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  templateId        String
  template          SiteTemplate    @relation(fields: [templateId], references: [id])
  status            SiteOrderStatus @default(SUBMITTED)
  paymentStatus     PaymentStatus   @default(PENDING)
  price             Decimal?        @db.Decimal(10, 2)
  responsibleUserId String?
  slaDeadline       DateTime?
  requirePaymentBeforePublish Boolean @default(true)
  
  // Enterprise Data
  businessName      String
  responsibleName   String
  phone             String
  email             String
  city              String?
  state             String?
  address           String?
  instagram         String?
  website           String?
  googleMyBusiness  String?
  
  // Commercial Data
  segment           String?
  description       String?
  services          String?
  differentials     String?
  audience          String?
  serviceRegion     String?
  
  // Operation Data
  openingHours      String?
  closingHours      String?
  workingDays       String?
  
  // Control
  responsibleId     String?
  priority          String          @default("NORMAL") // NORMAL, ATENÇÃO, ATRASADO
  token             String          @unique @default(cuid())
  submittedAt       DateTime?       @default(now())
  approvedAt        DateTime?
  publishedAt       DateTime?
  publishedUrl      String?
  
  history           SiteOrderHistory[]
  versions          SiteOrderVersion[]
  files             SiteOrderFile[]
  internalNotes     InternalNote[]
  notifications     NotificationLog[]
  payments          Payment[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SiteOrderHistory {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  fromStatus    SiteOrderStatus?
  toStatus      SiteOrderStatus
  fromPaymentStatus PaymentStatus?
  toPaymentStatus   PaymentStatus?
  priceAtMoment     Decimal?        @db.Decimal(10, 2)
  changedBy       String?

  responsibleUserId String?
  comment         String?

  createdAt     DateTime  @default(now())
}

model SiteOrderVersion {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  version           Int
  versionNumber     Int             @default(1)
  contentSnapshot   Json?
  previewUrl        String
  previewImage      String?
  notes             String?
  status            SiteOrderVersionStatus @default(DRAFT)
  createdBy         String?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())

  approvals     ApprovalRequest[]
}

model ApprovalRequest {
  id                  String                @id @default(cuid())
  orderId             String
  orderVersionId      String
  orderVersion        SiteOrderVersion      @relation(fields: [orderVersionId], references: [id])
  tokenHash           String                @unique
  status              ApprovalRequestStatus @default(PENDING)
  feedback            String?
  expiresAt           DateTime?
  versionId           String?
  usedAt              DateTime?

  ipAddress           String?
  userAgent           String?
  createdAt           DateTime              @default(now())
}

model InternalNote {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  message       String
  createdAt     DateTime  @default(now())
}

model NotificationLog {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  event         String
  channel       String    // WHATSAPP, EMAIL
  recipient     String
  message       String
  status        NotificationStatus @default(PENDING)
  externalId    String?
  error         String?
  idempotencyKey String?  @unique
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
}

model SiteOrderFile {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  name          String
  url           String
  type          String
  size          Int
  category      String    // logo, photo, document, video
  uploadedAt    DateTime  @default(now())
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           SiteOrder     @relation(fields: [orderId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  proofUrl        String?
  rejectionReason String?
  externalId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
