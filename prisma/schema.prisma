generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SAAS
  SERVICE
  SOLUTION
  MEDIA
}

enum LeadType {
  GENERAL
  DEMO
  QUOTE
  SCREEN_INSTALLATION
  SCREEN_ADVERTISING
  PARTNER
}

enum RevenueType {
  SUBSCRIPTION
  ONE_TIME
  RECURRING_SERVICE
  MEDIA
}

enum UserRole {
  ADMIN
  PARTNER
  CUSTOMER
  STUDENT
}

enum SiteOrderStatus {
  SUBMITTED
  DATA_REVIEW
  IN_PRODUCTION
  WAITING_APPROVAL
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  CANCELLED
}

enum SiteOrderVersionStatus {
  DRAFT
  WAITING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  EXPIRED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}



model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(CUSTOMER)
  partnerProfile PartnerProfile?
  subscriptions Subscription[]
  leads         Lead[]
  siteOrders    SiteOrder[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PartnerProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  commission    Float     @default(0.2)
  clientsCount  Int       @default(0)
  points        Int       @default(0)
  status        String    @default("active")
}

model Product {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  type              ProductType
  category          String
  segment           String
  subcategory       String?
  shortDescription  String
  description       String
  audience          String?
  problem           String?
  solution          String?
  features          Json?     // Array of {title, desc}
  pricingType       RevenueType
  pricing           String?
  ctaType           String?
  demoUrl           String?
  landingUrl        String?
  whatsappMessage   String?
  status            String    @default("active")
  featured          Boolean   @default(false)
  sortOrder         Int       @default(0)
  subscriptions     Subscription[]
  recommendations   ProductRecommendation[] @relation("MainProduct")
  recommendedBy     ProductRecommendation[] @relation("RecommendedProduct")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ProductRecommendation {
  id                  String    @id @default(cuid())
  productId           String
  product             Product   @relation("MainProduct", fields: [productId], references: [id])
  recommendedProductId String
  recommendedProduct  Product   @relation("RecommendedProduct", fields: [recommendedProductId], references: [id])
  reason              String
  priority            Int       @default(0)
  status              String    @default("active")
}

model Lead {
  id            String    @id @default(cuid())
  name          String
  email         String?
  whatsapp      String
  company       String?
  city          String?
  address       String?
  establishmentType String?
  screenCount   Int?
  segment       String?
  objective     String?
  message       String?
  type          LeadType  @default(GENERAL)
  status        String    @default("new")
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  diagnosticSessionId String? @unique
  diagnosticSession   DiagnosticSession? @relation(fields: [diagnosticSessionId], references: [id])
}

model DiagnosticSession {
  id                String    @id @default(cuid())
  leadId            String?
  sessionId         String?
  currentStep       Int       @default(1)
  status            String    @default("started") // started, in_progress, completed, abandoned
  businessSegment   String?
  mainProblem       String?
  specificNeed      String?
  currentOperation  String?
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lead              Lead?     
  result            DiagnosticResult?
}

model DiagnosticResult {
  id                  String    @id @default(cuid())
  diagnosticSessionId String    @unique
  diagnosticSession   DiagnosticSession @relation(fields: [diagnosticSessionId], references: [id])
  recommendedProductId String?
  confidence          String?   // HIGH, MEDIUM, LOW
  score               Int       @default(0)
  reason              String?
  recommendations     DiagnosticRecommendation[]
  createdAt           DateTime  @default(now())
}

model DiagnosticRecommendation {
  id                  String    @id @default(cuid())
  diagnosticResultId  String
  diagnosticResult    DiagnosticResult @relation(fields: [diagnosticResultId], references: [id])
  productId           String
  score               Int
  position            Int       @default(0)
  reason              String?
}

model DiagnosticRule {
  id          String    @id @default(cuid())
  segment     String?
  problem     String?
  need        String?
  operation   String?
  productId   String
  score       Int
  priority    Int       @default(0)
  message     String?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Course {
  id            String    @id @default(cuid())
  title         String
  description   String
  thumbnail     String?
  lessons       Lesson[]
  createdAt     DateTime  @default(now())
}

model Lesson {
  id            String    @id @default(cuid())
  courseId      String
  course        Course    @relation(fields: [courseId], references: [id])
  title         String
  videoUrl      String
  duration      String?
  order         Int
  createdAt     DateTime  @default(now())
}

model SiteTemplate {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  category      String
  segment       String
  description   String
  application   String?
  previewImage  String?
  externalUrl   String?
  status        String    @default("active")
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  orders        SiteOrder[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SiteOrder {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  templateId        String
  template          SiteTemplate    @relation(fields: [templateId], references: [id])
  status            SiteOrderStatus @default(SUBMITTED)
  
  // Enterprise Data
  businessName      String
  responsibleName   String
  phone             String
  email             String
  city              String?
  state             String?
  address           String?
  instagram         String?
  website           String?
  googleMyBusiness  String?
  
  // Commercial Data
  segment           String?
  description       String?
  services          String?
  differentials     String?
  audience          String?
  serviceRegion     String?
  
  // Operation Data
  openingHours      String?
  closingHours      String?
  workingDays       String?
  
  // Control
  responsibleId     String?
  priority          String          @default("NORMAL") // NORMAL, ATENÇÃO, ATRASADO
  token             String          @unique @default(cuid())
  submittedAt       DateTime?       @default(now())
  approvedAt        DateTime?
  publishedAt       DateTime?
  publishedUrl      String?
  
  history           SiteOrderHistory[]
  versions          SiteOrderVersion[]
  files             SiteOrderFile[]
  internalNotes     InternalNote[]
  notifications     NotificationLog[]
  
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SiteOrderHistory {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  fromStatus    SiteOrderStatus?
  toStatus      SiteOrderStatus
  changedBy     String?
  comment       String?
  createdAt     DateTime  @default(now())
}

model SiteOrderVersion {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  version       Int
  previewUrl    String
  previewImage  String?
  notes         String?
  status        SiteOrderVersionStatus @default(DRAFT)
  createdBy     String?
  createdAt     DateTime  @default(now())
  approvals     ApprovalRequest[]
}

model ApprovalRequest {
  id                  String                @id @default(cuid())
  orderId             String
  orderVersionId      String
  orderVersion        SiteOrderVersion      @relation(fields: [orderVersionId], references: [id])
  tokenHash           String                @unique
  status              ApprovalRequestStatus @default(PENDING)
  feedback            String?
  expiresAt           DateTime?
  usedAt              DateTime?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime              @default(now())
}

model InternalNote {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  userId        String
  message       String
  createdAt     DateTime  @default(now())
}

model NotificationLog {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  event         String
  channel       String    // WHATSAPP, EMAIL
  recipient     String
  message       String
  status        NotificationStatus @default(PENDING)
  externalId    String?
  error         String?
  idempotencyKey String?  @unique
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
}

model SiteOrderFile {
  id            String    @id @default(cuid())
  orderId       String
  order         SiteOrder @relation(fields: [orderId], references: [id])
  name          String
  url           String
  type          String
  size          Int
  category      String    // logo, photo, document, video
  uploadedAt    DateTime  @default(now())
}



model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
