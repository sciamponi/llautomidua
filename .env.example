# ==============================================================================
# AUTOMATIZA SOLUÇÃO - ARQUIVO DE AMBIENTE (.env)
# ==============================================================================

# 1. BANCO DE DADOS (POSTGRESQL)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# No Docker Compose, HOST deve ser 'db'
DATABASE_URL="postgresql://user:password@db:5432/automatiza?schema=public"

# 2. SEGURANÇA E AUTH
# Segredos para JWT e tokens de segurança. MUDAR EM PRODUÇÃO!
JWT_SECRET="mudar_esse_valor_em_producao_123456"
BOOTSTRAP_SECRET="mudar_esse_valor_para_executar_o_setup_inicial"
SHA256_SALT="mudar_esse_valor_para_tokens_do_sistema"

# 3. MASTER ADMIN INICIAL
# Credenciais para o primeiro usuário MASTER_ADMIN (usado no bootstrap)
MASTER_ADMIN_EMAIL="admin@automatizasolucao.com.br"
MASTER_ADMIN_PASSWORD="mudar_senha_fortemente_123!"

# 4. APLICAÇÃO
APP_URL="https://automatizasolucao.com.br"
NODE_ENV="production"
PORT=3000

# 5. STORAGE
# Caminho absoluto para persistência de arquivos
STORAGE_PATH="/data/storage"

# 6. INTEGRAÇÕES (OPCIONAL)
# Asaas (Pagamentos)
ASAAS_API_KEY=""

# Telegram (Alertas)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Resend (Emails)
RESEND_API_KEY=""

# WhatsApp
WHATSAPP_API_TOKEN=""
WHATSAPP_API_ENDPOINT=""
