# Environment Variables Example

# DATABASE
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@db:5432/automatiza?schema=public

# APP
APP_URL=https://sua-url.com
NODE_ENV=production
PORT=3000

# STORAGE
# Path where files will be stored (relative to container or absolute)
STORAGE_PATH=/data/storage

# AUTH (If applicable)
# BETTER_AUTH_SECRET=

# WHATSAPP INTEGRATION
# Currently defined in src/lib/notifications.functions.ts (mocked)
# Requires integration keys for real provider
WHATSAPP_API_TOKEN=
WHATSAPP_API_ENDPOINT=

# EMAIL INTEGRATION
# SMTP or API Provider credentials
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
